<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.amalitech</groupId>
    <artifactId>student-grade-management</artifactId>
    <version>2.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
        <mockito.version>5.23.0</mockito.version>

        <!--
            sourceDirectory and testSourceDirectory below both point at `src`
            (see the comment above <build>), which is fine for javac/surefire
            (the compiler plugin's own excludes handle it) but the Sonar
            Scanner derives its main/test file sets directly from these two
            properties - if left unset, it sees the identical `src` path for
            both and refuses to index any file "twice". These three
            properties tell it explicitly how to split the one physical tree:
            everything under src/tests is a test file, everything else under
            src is a main file, and the two sets never overlap.
        -->
        <sonar.sources>src</sonar.sources>
        <sonar.exclusions>src/tests/**</sonar.exclusions>
        <sonar.tests>src/tests</sonar.tests>

        <!--
            Main.java is the composition root: it only builds and wires the dependency graph, then
            hands off to ConsoleApp (see Main's own class Javadoc for why it's "deliberately too
            thin to need a test of its own"). Excluded from the coverage calculation entirely,
            rather than left dragging the overall percentage down for code that has nothing to
            branch on or get wrong in a way a test would catch.
        -->
        <sonar.coverage.exclusions>src/main/app/Main.java</sonar.coverage.exclusions>

        <!--
            java:S106 ("Replace this use of System.out by a logger") is a
            false positive by design in main.console/ and main.app/: System.out IS this
            application's user-facing menu/report output, deliberately kept
            on a separate stream from Logger (which writes diagnostics to
            System.err - see main.logging.Logger's own class Javadoc). Routing
            every println through Logger would prefix every menu line, table
            row, and report with a "[timestamp] LEVEL" tag, corrupting the
            actual main.console UI it's supposed to render. Excluded here, by
            rule and by path, rather than suppressed issue-by-issue in the
            SonarQube UI, so the exception is itself reviewable in version
            control.
        -->
        <sonar.issue.ignore.multicriteria>e1,e2,e3,e4,e5,e6,e7,e8,e9,e10,e11</sonar.issue.ignore.multicriteria>
        <sonar.issue.ignore.multicriteria.e1.ruleKey>java:S106</sonar.issue.ignore.multicriteria.e1.ruleKey>
        <sonar.issue.ignore.multicriteria.e1.resourceKey>src/main/console/**/*.java</sonar.issue.ignore.multicriteria.e1.resourceKey>
        <sonar.issue.ignore.multicriteria.e2.ruleKey>java:S106</sonar.issue.ignore.multicriteria.e2.ruleKey>
        <sonar.issue.ignore.multicriteria.e2.resourceKey>src/main/app/**/*.java</sonar.issue.ignore.multicriteria.e2.resourceKey>
        <!--
            model.*'s display*Details() methods (HonorsStudent, RegularStudent,
            Grade, CoreSubject, ElectiveSubject) and manager.GradeManager/
            StudentManager's direct printing (viewGradesByStudent, etc.) predate
            this cleanup - genuine presentation-in-the-wrong-layer, not a rule
            mismatch like console/app above, but not something being newly
            introduced or fixed here either. Excluded so it's visible and
            reviewable rather than newly silenced without a trace; moving this
            output into console/ properly is a real, separate refactor task.
        -->
        <sonar.issue.ignore.multicriteria.e3.ruleKey>java:S106</sonar.issue.ignore.multicriteria.e3.ruleKey>
        <sonar.issue.ignore.multicriteria.e3.resourceKey>src/main/model/**/*.java</sonar.issue.ignore.multicriteria.e3.resourceKey>
        <sonar.issue.ignore.multicriteria.e4.ruleKey>java:S106</sonar.issue.ignore.multicriteria.e4.ruleKey>
        <sonar.issue.ignore.multicriteria.e4.resourceKey>src/main/manager/**/*.java</sonar.issue.ignore.multicriteria.e4.resourceKey>
        <!--
            java:S1075 ("Remove this hard-coded path-delimiter") flags
            FileExporter's `reportsDir + "/" + filename`. The forward slash here
            is deliberate, not a portability bug: FileExportResult.getFilePath()
            is a *string* contract other code and tests depend on being exactly
            "<reportsDir>/<filename>" regardless of OS (see FileExporterTest) -
            actual file I/O already goes through java.nio.file.Path, which
            normalizes separators correctly on its own regardless of this
            string's literal content.
        -->
        <sonar.issue.ignore.multicriteria.e5.ruleKey>java:S1075</sonar.issue.ignore.multicriteria.e5.ruleKey>
        <sonar.issue.ignore.multicriteria.e5.resourceKey>src/main/export/FileExporter.java</sonar.issue.ignore.multicriteria.e5.resourceKey>
        <!--
            java:S106 also covers System.err, not just System.out - and flags
            Logger.log()'s own System.err.printf call. This is the one
            intentional place that write happens: Logger *is* "the logger" this
            rule otherwise asks callers to use, so there is nothing to replace
            it with.
        -->
        <sonar.issue.ignore.multicriteria.e6.ruleKey>java:S106</sonar.issue.ignore.multicriteria.e6.ruleKey>
        <sonar.issue.ignore.multicriteria.e6.resourceKey>src/main/logging/Logger.java</sonar.issue.ignore.multicriteria.e6.resourceKey>
        <!--
            java:S106 also flags StatisticsDashboard's own print() (US-5/PBI-5) - its
            System.out lines ARE the live dashboard's user-facing display, the exact same
            "this is the UI, not diagnostics" rationale as e1/e2 above for console/app,
            just for a v3 background-refresh feature instead of a menu action.
        -->
        <sonar.issue.ignore.multicriteria.e7.ruleKey>java:S106</sonar.issue.ignore.multicriteria.e7.ruleKey>
        <sonar.issue.ignore.multicriteria.e7.resourceKey>src/main/concurrent/StatisticsDashboard.java</sonar.issue.ignore.multicriteria.e7.resourceKey>
        <!--
            java:S3077 flags ScheduledGpaRecalculationJob.lastResult - a volatile
            NavigableMap<Double, List<Student>> - for not being a "thread-safe type". The rule's
            general concern is real (volatile doesn't make a mutable collection's own methods safe
            to call from multiple threads), but doesn't apply to how this field is actually used:
            every write replaces the whole reference with a brand-new TreeMap built in one
            uninterrupted pass (see runOnce()) - nothing ever mutates a map another thread might be
            reading. volatile's happens-before guarantee on the reference itself is exactly what's
            needed for that publish-once pattern.
        -->
        <sonar.issue.ignore.multicriteria.e8.ruleKey>java:S3077</sonar.issue.ignore.multicriteria.e8.ruleKey>
        <sonar.issue.ignore.multicriteria.e8.resourceKey>src/main/concurrent/ScheduledGpaRecalculationJob.java</sonar.issue.ignore.multicriteria.e8.resourceKey>
        <!--
            java:S2925 ("Remove this use of Thread.sleep()") flags three test files where a real
            wait is the point, not a smell to poll away:
            - ScheduledGpaRecalculationJobTest: confirming a job produces *no further* runs after
              stop() is a negative assertion with no condition to poll for - it can only be proven
              by letting a real interval pass and checking nothing changed (the *positive* "wait
              for the next run" case in the same file already uses polling instead, see
              awaitFirstRun()/awaitRunAfter())
            - StatisticsDashboardTest: waits for >=2 real background refreshes while stdout is being
              captured mid-flight - the captured buffer isn't readable until capture ends, so there
              is nothing to poll on until the wait is already over
            - BatchReportServiceMockitoTest: simulates realistic per-student work duration inside a
              mocked answer, specifically to measure the sequential-vs-parallel speedup (US-4/PBI-4)
              - the sleep IS the workload being measured, not something waiting on it
        -->
        <sonar.issue.ignore.multicriteria.e9.ruleKey>java:S2925</sonar.issue.ignore.multicriteria.e9.ruleKey>
        <sonar.issue.ignore.multicriteria.e9.resourceKey>src/tests/concurrent/ScheduledGpaRecalculationJobTest.java</sonar.issue.ignore.multicriteria.e9.resourceKey>
        <sonar.issue.ignore.multicriteria.e10.ruleKey>java:S2925</sonar.issue.ignore.multicriteria.e10.ruleKey>
        <sonar.issue.ignore.multicriteria.e10.resourceKey>src/tests/concurrent/StatisticsDashboardTest.java</sonar.issue.ignore.multicriteria.e10.resourceKey>
        <sonar.issue.ignore.multicriteria.e11.ruleKey>java:S2925</sonar.issue.ignore.multicriteria.e11.ruleKey>
        <sonar.issue.ignore.multicriteria.e11.resourceKey>src/tests/concurrent/BatchReportServiceMockitoTest.java</sonar.issue.ignore.multicriteria.e11.resourceKey>
    </properties>

    <!--
        This project keeps all main and test source under a single `src`
        directory (package `tests.*` lives at `src/tests/...`) rather than
        the conventional Maven `src/main/java` + `src/test/java` split - see
        CHANGELOG.md KI-11. Moving every file would touch every branch in
        flight; instead, main and test compilation both root at `src`, and
        the main `compile` goal explicitly excludes `tests/**` so it never
        needs JUnit/Mockito on its classpath.
    -->
    <build>
        <sourceDirectory>src</sourceDirectory>
        <testSourceDirectory>src</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <configuration>
                            <excludes>
                                <exclude>tests/**</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <configuration>
                    <excludes>
                        <!-- Composition root only - see the sonar.coverage.exclusions comment above for why. -->
                        <exclude>main/app/Main.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>main.app.Main</mainClass>
                                </transformer>
                            </transformers>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>3.9.1.2184</version>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- v3 PBI-2: JSON export/import (dataio package) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.2</version>
        </dependency>
    </dependencies>
</project>
