<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import java.lang.String?>
<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="hospital.management.components.buttons.LoadingButtonController"
      spacing="8"
      alignment="CENTER_LEFT">

    <stylesheets>
        <String value="/hospital/management/css/buttons.css"/>
        <String value="/hospital/management/css/spinner.css"/>
    </stylesheets>

    <Button fx:id="actionBtn" text="Save" styleClass="loading-button"/>
    <ProgressIndicator fx:id="spinner" prefWidth="20" prefHeight="20" visible="false"/>
</HBox>
