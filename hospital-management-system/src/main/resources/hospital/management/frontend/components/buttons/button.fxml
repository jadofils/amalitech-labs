<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import java.lang.String?>
<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="hospital.management.components.buttons.ButtonController"
      spacing="10"
      alignment="CENTER_LEFT">

    <stylesheets>
        <String value="/hospital/management/css/buttons.css"/>
    </stylesheets>

    <Button fx:id="saveBtn"   text="Save"   styleClass="primary-button"/>
    <Button fx:id="cancelBtn" text="Cancel" styleClass="secondary-button"/>
    <Button fx:id="deleteBtn" text="Delete" styleClass="danger-button"/>
</HBox>