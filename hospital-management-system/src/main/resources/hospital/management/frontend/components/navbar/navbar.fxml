<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="hospital.management.components.navbar.NavbarController"
      fx:id="navbarRoot"
      styleClass="navbar"
      spacing="4"
      alignment="CENTER_LEFT">

    <stylesheets>
        <String value="/hospital/management/css/navbar.css"/>
    </stylesheets>

    <Label text="+ HMS" styleClass="navbar-brand"/>

    <Region minWidth="24"/>

    <Button text="Dashboard"    styleClass="navbar-btn" onAction="#handleDashboard"/>
    <Button text="Patients"     styleClass="navbar-btn" onAction="#handlePatients"/>
    <Button text="Appointments" styleClass="navbar-btn" onAction="#handleAppointments"/>
    <Button text="Billing"      styleClass="navbar-btn" onAction="#handleBilling"/>

    <Region HBox.hgrow="ALWAYS"/>

    <Button text="[Alerts]" styleClass="navbar-icon-btn"/>
    <Button text="Dr. Admin" styleClass="navbar-btn" onAction="#handleProfile"/>
</HBox>