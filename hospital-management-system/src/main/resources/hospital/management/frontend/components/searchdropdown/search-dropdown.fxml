<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="hospital.management.components.searchdropdown.SearchableDropdownController"
      styleClass="searchable-dropdown"
      spacing="4">

    <stylesheets>
        <String value="/hospital/management/css/search-dropdown.css"/>
    </stylesheets>

    <TextField fx:id="searchField" promptText="Type to filter..."
               styleClass="dropdown-search-field"/>
    <ComboBox fx:id="dropdown" maxWidth="Infinity" styleClass="combo-box"/>
</VBox>