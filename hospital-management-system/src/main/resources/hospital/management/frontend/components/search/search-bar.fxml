<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="hospital.management.components.search.SearchBarController"
      spacing="8"
      alignment="CENTER_LEFT">

    <stylesheets>
        <String value="/hospital/management/css/search.css"/>
    </stylesheets>

    <TextField fx:id="searchField" promptText="Search patients, doctors..."
               styleClass="search-field" HBox.hgrow="ALWAYS"/>
    <Button fx:id="searchBtn" text="Search" styleClass="search-button"/>
</HBox>