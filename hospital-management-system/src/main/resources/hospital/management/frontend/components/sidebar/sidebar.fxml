<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="hospital.management.components.sidebar.SidebarController"
      fx:id="sidebarRoot"
      styleClass="sidebar"
      spacing="2">

    <stylesheets>
        <String value="/hospital/management/css/sidebar.css"/>
    </stylesheets>

    <Label text="MENU" styleClass="sidebar-section-label"/>

    <Button fx:id="dashboardBtn"    text="Dashboard"    styleClass="sidebar-item"
            maxWidth="Infinity" onAction="#handleDashboard"/>
    <Button fx:id="patientsBtn"     text="Patients"     styleClass="sidebar-item"
            maxWidth="Infinity" onAction="#handlePatients"/>
    <Button fx:id="appointmentsBtn" text="Appointments" styleClass="sidebar-item"
            maxWidth="Infinity" onAction="#handleAppointments"/>
    <Button fx:id="billingBtn"      text="Billing"      styleClass="sidebar-item"
            maxWidth="Infinity" onAction="#handleBilling"/>

    <Label text="REPORTS" styleClass="sidebar-section-label"/>
    <Button text="Analytics" styleClass="sidebar-item" maxWidth="Infinity"/>
    <Button text="Reports"   styleClass="sidebar-item" maxWidth="Infinity"/>

    <Region VBox.vgrow="ALWAYS"/>

    <Label text="ACCOUNT" styleClass="sidebar-section-label"/>
    <Button text="Settings"  styleClass="sidebar-item" maxWidth="Infinity"/>
    <Button text="Logout"    styleClass="sidebar-item danger-item"
            maxWidth="Infinity" onAction="#handleLogout"/>
</VBox>
